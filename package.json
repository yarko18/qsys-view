{
  "name": "qsys-view",
  "displayName": "Qsys View",
  "description": "Explore Intel Platform Designer .qsys systems, exported Tcl scripts, and *_hw.tcl components as readable layered graphs.",
  "version": "1.1.0",
  "publisher": "YaroslavMariukha",
  "author": {
    "name": "Mariukha Yaroslav"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["fpga", "intel", "quartus", "qsys", "tcl", "platform designer", "avalon"],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:qsysView.graph",
    "onCustomEditor:qsysView.tclGraph",
    "onCustomEditor:qsysView.hwTclGraph",
    "onCommand:qsysView.openGraph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qsysView.openGraph",
        "title": "Open Qsys Graph",
        "category": "Qsys View"
      }
    ],
    "customEditors": [
      {
        "viewType": "qsysView.graph",
        "displayName": "Qsys Graph",
        "selector": [{ "filenamePattern": "*.qsys" }],
        "priority": "default"
      },
      {
        "viewType": "qsysView.tclGraph",
        "displayName": "Qsys TCL Graph",
        "selector": [{ "filenamePattern": "*.tcl" }],
        "priority": "option"
      },
      {
        "viewType": "qsysView.hwTclGraph",
        "displayName": "Platform Designer IP",
        "selector": [{ "filenamePattern": "*_hw.tcl" }],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Qsys View",
      "properties": {
        "qsysView.quartusPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to a Quartus installation directory or directly to qsys-script. Leave empty to use QUARTUS_ROOTDIR, conventional install locations, or PATH."
        },
        "qsysView.platformDesignerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to the Platform Designer executable (qsys-edit or qsys.exe). Leave empty to use qsysView.quartusPath, QUARTUS_ROOTDIR, conventional install locations, or PATH."
        },
        "qsysView.ipSearchPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "description": "Additional Platform Designer IP search paths. Relative paths use the Qsys directory; ${qsysDir} and ${workspaceFolder} are supported. Standard Quartus IP and local component.ipx files are added automatically."
        },
        "qsysView.tclVariables": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          },
          "description": "Global Tcl variables to set before evaluating or opening a Platform Designer Tcl system, for example {\"PLATFORM_CONFIG\": \"WHC\"}."
        },
        "qsysView.tclshPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to tclsh for automatic safe resolution of systems and *_hw.tcl component callbacks. Leave empty to use tclsh from PATH."
        },
        "qsysView.rememberLastViewState": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Remember the last view mode, interface filters, All IP, Disabled IP, and clock/reset name inference across Qsys View editors."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "qsysView.openGraph",
          "when": "resourceExtname == .qsys || resourceExtname == .tcl",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "qsysView.openGraph",
          "when": "resourceExtname == .qsys || resourceExtname == .tcl",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit && eslint .",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "npm run check && npm test && npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "elkjs": "^0.11.0",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/yarko-fpga/qsys-view.git"
  },
  "bugs": {
    "url": "https://gitlab.com/yarko-fpga/qsys-view/-/issues"
  },
  "homepage": "https://gitlab.com/yarko-fpga/qsys-view"
}
